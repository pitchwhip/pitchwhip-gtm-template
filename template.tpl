___TESTS___

scenarios:
- name: Loads the snippet for the site key
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure) {
      assertThat(url).isEqualTo('https://px.pitchwhip.com/v1/px/AbCdEfGhIjKlMnOpQrStUv12.js');
      onSuccess();
    });
    runCode(mockData);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Consent Mode granted sends consent
  code: |-
    mock('isConsentGranted', function(t) { return t === 'analytics_storage'; });
    runCode(mockData);
    assertThat(copyFromWindow('pitchwhip.q')).isEqualTo([['consent']]);
- name: Consent Mode not granted sends nothing yet
  code: |-
    mock('isConsentGranted', function(t) { return false; });
    runCode(mockData);
    const q = copyFromWindow('pitchwhip.q');
    assertThat(q === undefined || q.length === 0).isTrue();
    assertApi('addConsentListener').wasCalled();
- name: Never send consent
  code: |-
    mockData.consentMode = 'never';
    mock('isConsentGranted', function(t) { return true; });
    runCode(mockData);
    const q = copyFromWindow('pitchwhip.q');
    assertThat(q === undefined || q.length === 0).isTrue();
    assertApi('addConsentListener').wasNotCalled();
- name: Always send consent and identify
  code: |-
    mockData.consentMode = 'always';
    mockData.identifyEmail = 'jane@acme.com';
    runCode(mockData);
    assertThat(copyFromWindow('pitchwhip.q')).isEqualTo([['consent'], ['identify', 'jane@acme.com']]);
- name: Failure is reported
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure) { onFailure(); });
    runCode(mockData);
    assertApi('gtmOnFailure').wasCalled();
setup: |-
  const copyFromWindow = require('copyFromWindow');
  const setInWindow = require('setInWindow');
  setInWindow('pitchwhip', undefined, true);
  mock('injectScript', function(url, onSuccess, onFailure) { onSuccess(); });
  const mockData = {
    "siteKey": "AbCdEfGhIjKlMnOpQrStUv12",
    "consentMode": "consent_mode"
  };


