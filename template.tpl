___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const encodeUriComponent = require('encodeUriComponent');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const logToConsole = require('logToConsole');

const key = data.siteKey;
// Same queue as the PitchWhip snippet: calls made before the script loads wait in pitchwhip.q.
const pitchwhip = createArgumentsQueue('pitchwhip', 'pitchwhip.q');

if (data.consentMode === 'always') {
  pitchwhip('consent');
} else if (data.consentMode === 'consent_mode') {
  if (isConsentGranted('analytics_storage')) {
    pitchwhip('consent');
  } else {
    let sent = false;
    addConsentListener('analytics_storage', (consentType, granted) => {
      if (granted && !sent) {
        sent = true;
        pitchwhip('consent');
      }
    });
  }
}

if (data.identifyEmail) {
  // The PitchWhip script keeps only the part after the @.
  pitchwhip('identify', data.identifyEmail);
}

const src = 'https://px.pitchwhip.com/v1/px/' + encodeUriComponent(key) + '.js';
logToConsole('PitchWhip Website Visitors: loading', src);
injectScript(src, data.gtmOnSuccess, data.gtmOnFailure, 'pitchwhip-' + key);


